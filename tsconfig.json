{
    "compilerOptions": {
        "target": "ES2020",
        "module": "nodenext",
        "rootDir": "src",
        "outDir": "dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "moduleResolution": "nodenext",
        "types": ["node"],
        "paths": {
            "#prisma7/client": [
                //
                "./src/generated/prisma/client"
            ],
            "#prisma7/error": [
                //
                "./src/prisma-error"
            ]
        }
    },
    "include": ["src"]
}
