{
    "name": "pijon-bot",
    "version": "2.1.3",
    "description": "Lé Pijons Discord Server Bot",
    "main": "index.js",
    "scripts": {
        "start": "node . -all",
        "debug": "node . -all -DEBUG",
        "deploy": "node tools/deploy-commands.js",
        "clean-logs": "node tools/clean-logs.js",
        "patch-distube": "npm uninstall ffmpeg-static npm ci --no-optional npm update",
        "patch-discordjs-voice": "node tools/patcher-discordjs-voice.js",
        "reinstall": "rm ./node_modules && npm install"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Darco2903/Pijon-Bot.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Darco2903/Pijon-Bot/issues"
    },
    "homepage": "https://github.com/Darco2903/Pijon-Bot#readme",
    "dependencies": {
        "@discordjs/opus": "^0.9.0",
        "@discordjs/voice": "^0.15.0",
        "@distube/ytdl-core": "^4.11.11",
        "console-log-colors": "^0.4.0",
        "darco2903-db": "^1.5.0",
        "discord.js": "^14.8.0",
        "distube": "^4.0.4",
        "ffmpeg-static": "^4.4.1",
        "mysql": "^2.18.1",
        "openai": "^3.2.1",
        "tweetnacl": "^1.0.3"
    },
    "devDependencies": {
        "darco2903-os-command-kit": "^1.1.0"
    }
}
