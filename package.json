{
    "name": "pijon-bot",
    "version": "3.0.0",
    "description": "Lé Pijons Discord Server Bot",
    "main": "dist/index.js",
    "keywords": [],
    "author": "Darco2903",
    "license": "ISC",
    "private": "true",
    "type": "module",
    "packageManager": "pnpm@12.8.1",
    "scripts": {
        "build": "run-s build:db build:ts",
        "build:ts": "tsc",
        "build:db": "pnpm exec prisma generate",
        "update:db": "pnpm exec prisma db pull",
        "start": "node .",
        "dev": "tsx src/index.ts --dev",
        "clean": "rimraf dist src/generated",
        "test": "vitest run",
        "test:watch": "vitest watch",
        "deploy": "node dist/tools/deploy-commands.js"
    },
    "imports": {
        "#prisma7/client": [
            "./dist/generated/prisma/client.js"
        ],
        "#prisma7/error": [
            "./dist/prisma-error.js"
        ]
    },
    "dependencies": {
        "@darco2903/secondthought": "^1.3.1",
        "@darco2903/track-queue": "^1.1.3",
        "@discordjs/voice": "^0.19.2",
        "@prisma/adapter-mariadb": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "@snazzah/davey": "^0.1.12",
        "@snazzah/davey-linux-arm64-musl": "^0.1.12",
        "discord.js": "^14.27.0",
        "dotenv": "^18.0.4",
        "fish-audio": "^0.1.0",
        "neverthrow": "^8.2.0",
        "node-cron": "^4.6.0",
        "openai": "^7.25.0",
        "opusscript": "^0.1.1",
        "pino": "^10.3.1",
        "prism-media": "^1.3.5",
        "ytdl-core": "^4.11.5",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^24.19.0",
        "npm-run-all2": "^9.0.3",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.9",
        "prisma": "7.10.0",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
