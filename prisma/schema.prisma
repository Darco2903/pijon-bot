generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model recently_played {
  id        Int      @id @default(autoincrement()) @db.UnsignedSmallInt
  video_id  String   @unique(map: "unique_video_id") @db.VarChar(12)
  title     String   @db.VarChar(100)
  played_at DateTime @db.Timestamp(0)
}

model ai_channel_state {
  channel_id String   @id @db.VarChar(20)
  summary    String   @db.Text
  /// last message folded into the summary
  cursor_id  String?  @db.VarChar(20)
  updated_at DateTime @updatedAt @db.Timestamp(0)
}

model ai_memory {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  /// guild id, or the channel id for DMs
  scope_id   String   @db.VarChar(20)
  user_id    String?  @db.VarChar(20)
  content    String   @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@index([scope_id])
}
